<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>BookMyTicket | Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <style>
    body {
      font-family: "Poppins", sans-serif;
      background: #f8f9fa;
    }

    .sidebar {
      height: 100vh;
      background: #212529;
      color: #fff;
      position: fixed;
      width: 240px;
      top: 0;
      left: 0;
      padding-top: 20px;
    }

    .sidebar .nav-link {
      color: #adb5bd;
      font-weight: 500;
      padding: 12px 20px;
      border-radius: 8px;
      margin: 5px 10px;
    }

    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
      background: #dc3545;
      color: #fff;
    }

    .main-content {
      margin-left: 240px;
      padding: 20px;
    }

    .card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

    .navbar {
      border-radius: 12px;
    }

    .chart-box {
      min-height: 300px;
    }
  </style>
</head>

<body>
  <!-- Sidebar -->
  <div class="sidebar">
    <div class="text-center mb-4">
      <h4 class="fw-bold text-danger">BookMyTicket</h4>
    </div>
    <ul class="nav flex-column">
      <li><a href="/admin" class="nav-link active"><i class="fa fa-gauge"></i> Dashboard</a></li>
      <li><a href="/addMovie" class="nav-link"><i class="fa fa-film"></i> Add Movie</a></li>
      <li><a href="/list" class="nav-link"><i class="fa fa-list"></i> Movie List</a></li>
      <li><a href="/trailer" class="nav-link"><i class="fa fa-play"></i> Trailers</a></li>
    </ul>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-3 mb-4">
      <a class="navbar-brand fw-bold text-danger" href="#">Admin Panel</a>
      <div class="ms-auto">
        <button class="btn btn-outline-danger btn-sm"><i class="fa fa-sign-out-alt"></i> Logout</button>
      </div>
    </nav>

    <!-- Dashboard Stats -->
    <div class="row g-4 mb-4">
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <h6 class="text-muted">Capacity</h6>
          <h3>105GB</h3>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <h6 class="text-muted">Revenue</h6>
          <h3>$1,345</h3>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <h6 class="text-muted">Errors</h6>
          <h3>23</h3>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <h6 class="text-muted">Followers</h6>
          <h3>+45</h3>
        </div>
      </div>
    </div>

    <!-- Charts & Calendar -->
    <div class="row g-4">
      <div class="col-md-8">
        <div class="card p-3">
          <h6 class="mb-3">Users Behavior</h6>
          <canvas id="userChart" class="chart-box"></canvas>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h6 class="mb-3">Calendar</h6>
          <input type="text" id="datepicker" class="form-control">
        </div>
      </div>
    </div>
  </div>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script
    src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
  <script>
    // Chart
    const ctx = document.getElementById('userChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ["0h", "4h", "8h", "12h", "16h", "20h", "24h"],
        datasets: [{
          label: 'Open',
          data: [12, 19, 14, 23, 18, 24, 20],
          borderColor: 'rgba(220,53,69,1)',
          tension: 0.3
        }]
      }
    });

    // Datepicker
    document.getElementById('datepicker').datepicker();
  </script>
</body>

</html>